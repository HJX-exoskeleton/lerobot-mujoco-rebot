  <!-- Keep both fingers mechanically synchronized: finger_right = -finger_left. -->
  <equality>
    <joint name="gripper_symmetry" joint1="finger_right" joint2="finger_left" polycoef="0 -1 0 0 0" solref="0.002 1" solimp="0.99 0.999 0.0001"/>
  </equality>

  <!-- This tendon coordinate equals one finger's travel (0..0.05 m). -->
  <tendon>
    <fixed name="gripper_opening">
      <joint joint="finger_left" coef="0.5"/>
      <joint joint="finger_right" coef="-0.5"/>
    </fixed>
  </tendon>

  <!-- Native position servos derived from the original simulation PD gains. -->
  <actuator>
    <position name="joint1_position" joint="joint1" kp="140" ctrllimited="true" ctrlrange="-2.8 2.8" forcelimited="true" forcerange="-30 30"/>
    <position name="joint2_position" joint="joint2" kp="140" ctrllimited="true" ctrlrange="-3.14 0" forcelimited="true" forcerange="-30 30"/>
    <position name="joint3_position" joint="joint3" kp="110" ctrllimited="true" ctrlrange="-3.14 0" forcelimited="true" forcerange="-30 30"/>
    <position name="joint4_position" joint="joint4" kp="55" ctrllimited="true" ctrlrange="-1.87 1.57" forcelimited="true" forcerange="-30 30"/>
    <position name="joint5_position" joint="joint5" kp="38" ctrllimited="true" ctrlrange="-1.57 1.57" forcelimited="true" forcerange="-30 30"/>
    <position name="joint6_position" joint="joint6" kp="28" ctrllimited="true" ctrlrange="-3.14 3.14" forcelimited="true" forcerange="-30 30"/>
    <!-- Coefficients halve force per finger, hence kp=3600 and actuator limit=64 N. -->
    <position name="gripper_position" tendon="gripper_opening" kp="3600" ctrllimited="true" ctrlrange="0.001 0.05" forcelimited="true" forcerange="-64 64"/>
  </actuator>

