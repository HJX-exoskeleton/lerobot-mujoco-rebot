<!--  <compiler angle="radian" coordinate="local" eulerseq="xyz" meshdir="meshes"/>-->
<!--  <option timestep="0.001" gravity="0 0 -9.81" iterations="100" noslip_iterations="20"/>-->
  <compiler angle="radian" inertiafromgeom="auto" meshdir="meshes"/>
  <size memory="500M"/>
  <!-- A smaller step and a few no-slip iterations prevent the two slides from
       exchanging an impulse when a pad first touches the object. -->
  <option timestep='0.0025' iterations="100" noslip_iterations="40" tolerance="1e-8" solver="Newton" jacobian="dense" cone="elliptic"/>

  <!-- add tactile -->
  <extension>
    <plugin plugin="mujoco.sensor.touch_grid"/>
  </extension>

