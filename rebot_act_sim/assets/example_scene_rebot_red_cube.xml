<mujoco model="reBot red cube pick-and-place">
  <!-- Included mesh paths normalize to repository-relative paths.  Resolve
       all of them from the repository root without affecting textures. -->
  <compiler meshdir="../.." texturedir="../.."/>
  <size memory="500M"/>
  <include file="../../asset/tabletop/object/object_table.xml"/>
  <!-- Official colored B601 arm; tabletop, cube and plate remain unchanged. -->
  <include file="rebotarm_b601_colored_act.xml"/>
  <include file="../../asset/objaverse/plate_11/model_new.xml"/>

  <!-- Preserve the original floor geometry/light, replacing only its builtin
       gradient sky with the official B601 desert skybox. -->
  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
  </visual>
  <asset>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
             rgb1="0.9 0.9 0.9" rgb2="0.8 0.8 0.8" markrgb="0.8 0.8 0.8"
             width="1000" height="1000"/>
    <material name="groundplane" texture="groundplane" texuniform="true"
              texrepeat="1 1" reflectance="0.1"/>
  </asset>

  <!--
    MuJoCo box size is half extent, so this is a 4 cm cube.
    The body name remains body_obj_mug_5 because the legacy SimpleEnv
    constructor looks it up during reset. rebot_act_sim treats it as the
    generic task object everywhere outside that compatibility boundary.
  -->
  <worldbody>
    <light pos="1 -1 1.5" dir="-1 1 -1" diffuse="0.5 0.5 0.5"
           directional="true"/>
    <geom name="floor" group="1" size="0 0 0.05" type="plane"
          material="groundplane"/>
    <body name="body_obj_mug_5" pos="0.32 0.08 0.82">
<!--      <freejoint/>-->
      <joint name="body_obj_mug_5_free" type="free" damping="0.01" frictionloss="0.01"/>
      <!-- 4 cm cube, 100 g. The explicit inertia must be updated together
           with geom mass; otherwise MuJoCo keeps using the old body mass. -->
      <inertial pos="0 0 0" mass="0.25" diaginertia="2.667e-5 2.667e-5 2.667e-5"/>
      <geom
        name="geom_obj_red_cube"
        type="box"
        size="0.02 0.02 0.02"
        mass="0.25"
        rgba="1 0 0 1"
        condim="3"
        friction="1.2 0.01 0.001"
        solimp="0.95 0.99 0.001"
        solref="0.01 1"
      />
    </body>
  </worldbody>

</mujoco>
